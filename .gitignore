.DS_Store
.idea/
.vscode/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
build/
dist/
*.egg-info/

# Future raw measurements and generated outputs are external by default.
data/raw/
data/processed/
results/generated/*
*.stl
*.step
*.stp
*.f3d
*.FCStd
graphify-out/

# CFD records ARE committed (work-order decision D11): manifests, uncertainty records and
# extracted result tables. The rule above is written as results/generated/* rather than
# results/generated/ precisely so this re-inclusion works: git will not descend into an excluded
# directory, so a negation under one has no effect and the records vanish silently.
!results/generated/cfd/
results/generated/cfd/.local/

